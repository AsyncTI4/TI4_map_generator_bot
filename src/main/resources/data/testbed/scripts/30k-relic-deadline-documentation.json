{
  "name": "30k-relic-deadline-documentation",
  "description": "Deadline Documentation: Sol targets Hacan, who moves 1 tactic token to the fleet pool; the relic ends exhausted.",
  "preset": "30k-2p",
  "stopOnFail": true,
  "steps": [
    { "do": "hand", "as": "sol", "hand": { "relics": ["deadlinedocumentation30k"] } },
    { "expect": { "state": "hacan.ccs", "equals": "3/3/2" } },
    { "as": "sol", "pressId": "FFCC_sol_componentActionRes_relic_deadlinedocumentation30k" },
    { "as": "sol", "press": "thirtyKDeadlineTarget_hacan" },
    { "expect": { "state": "sol.exhaustedRelics", "contains": "deadlinedocumentation30k" } },
    { "as": "hacan", "press": "thirtyKDeadlineMove_fleet", "in": "hacan:cards-info" },
    { "expect": { "state": "hacan.ccs", "equals": "2/4/2" } }
  ]
}
